{
  "name": "@gnanesh/dsh-menubar",
  "version": "0.1.3",
  "description": "DeepSeek Harness in your macOS menu bar: a host plugin that bridges a running dsh web host over an authenticated WebSocket, so asks made from a menu bar client become real tracked sessions.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client.js"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-gateway": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "menubar",
    "macos",
    "bridge",
    "sessions",
    "plugin"
  ],
  "author": {
    "name": "Gnanesh",
    "url": "https://github.com/GnaneshKunal"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GnaneshKunal/dsh-menubar.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/GnaneshKunal/dsh-menubar#readme",
  "bugs": {
    "url": "https://github.com/GnaneshKunal/dsh-menubar/issues"
  }
}
